<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3"
          xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings"
          manifestVersion="1.0">
  <assemblyIdentity type="win32" name="FICture2" version="1.0.0.0" processorArchitecture="amd64"/>
  
  <!-- Common-Controls v6 for modern UI styling -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32"
                        name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0"
                        processorArchitecture="amd64"
                        publicKeyToken="6595b64144ccf1df"
                        language="*"/>
    </dependentAssembly>
  </dependency>
  
  <!-- Windows 10+ compatibility declarations to reduce legacy checks -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 1809+ -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 11 -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
    </application>
  </compatibility>
  
  <asmv3:application>
    <asmv3:windowsSettings>
      <ws2:longPathAware>true</ws2:longPathAware>
      <ws2:dpiAwareness>permonitorv2</ws2:dpiAwareness>
      <!-- Disable high entropy ASLR may reduce some validation overhead (security trade-off) -->
      <ws2:heapType>SegmentHeap</ws2:heapType>
    </asmv3:windowsSettings>
  </asmv3:application>
  
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- asInvoker = no elevation, minimal privilege -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
