@echo off
setlocal enabledelayedexpansion

REM Fetches the winget manifests of a release published by CI.
REM Releases are created only by .github/workflows/release.yml when a v* tag is
REM pushed; this script never pushes a tag or creates a release, so a tag has a
REM single publisher. The manifests in the release were generated by CI from the
REM published installer's URL and SHA256.
REM
REM Usage: release_winget.bat [v<version>]
REM        (default: the latest published release)

set BUILD_DIR=build_winget
set MANIFEST_DIR=%BUILD_DIR%\winget_manifests
set DOWNLOAD_DIR=%BUILD_DIR%\release_download

where gh > nul 2>&1
if errorlevel 1 (
    echo Error: GitHub CLI ^(gh^) is required: https://cli.github.com/
    exit /b 1
)

set TAG=%~1
if not defined TAG (
    for /f "delims=" %%T in ('gh release view --json tagName --jq ".tagName" 2^>nul') do set TAG=%%T
)
if not defined TAG (
    echo Error: no tag given and no published release found
    echo Usage: release_winget.bat v^<version^>
    exit /b 1
)
set VERSION=!TAG:~1!

echo Release: !TAG!
set DRAFT=
for /f "delims=" %%D in ('gh release view !TAG! --json isDraft --jq ".isDraft" 2^>nul') do set DRAFT=%%D
if not defined DRAFT (
    echo Error: release !TAG! does not exist. Push the tag and let the Release workflow publish it.
    exit /b 1
)
if /i "!DRAFT!"=="true" (
    echo Error: release !TAG! is still a draft. Wait for, or re-run, the Release workflow.
    exit /b 1
)

if exist "%DOWNLOAD_DIR%" rmdir /s /q "%DOWNLOAD_DIR%"
mkdir "%DOWNLOAD_DIR%"
gh release download !TAG! --pattern "winget-manifests-!VERSION!.zip" --dir "%DOWNLOAD_DIR%"
if errorlevel 1 (
    echo Error: release !TAG! has no winget-manifests-!VERSION!.zip. Re-run the Release workflow to attach it.
    exit /b 1
)

if exist "%MANIFEST_DIR%" rmdir /s /q "%MANIFEST_DIR%"
mkdir "%MANIFEST_DIR%"
powershell -NoProfile -Command "Expand-Archive -Path '%DOWNLOAD_DIR%\winget-manifests-!VERSION!.zip' -DestinationPath '%MANIFEST_DIR%' -Force"
if errorlevel 1 (
    echo Error: could not extract the manifests
    exit /b 1
)

echo.
echo Manifests for !TAG! are in %MANIFEST_DIR%:
dir /b "%MANIFEST_DIR%\*.yaml"
echo.
echo Next step: submit_winget.bat
endlocal
