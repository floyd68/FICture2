[Setup]
AppName=@FICTURE2_INNO_APP_NAME@
AppVersion=@FICTURE2_VERSION_STRING@
AppPublisher=@FICTURE2_INNO_PUBLISHER@
AppId={{FICture2}}
DefaultDirName={autopf}\@FICTURE2_INNO_APP_NAME@
DefaultGroupName=@FICTURE2_INNO_APP_NAME@
OutputBaseFilename=@FICTURE2_INNO_OUTPUT_NAME@
SetupIconFile=@FICTURE2_INNO_ICON_PATH@
Compression=lzma2
SolidCompression=yes

[Tasks]
Name: "fileassoc"; Description: "Register file associations"
Name: "thumbprovider"; Description: "Register thumbnail provider"; Check: CanRegisterThumbnailProvider
Name: "startmenu"; Description: "Create Start Menu shortcuts"

[Files]
Source: "@FICTURE2_INNO_EXE_PATH@"; DestDir: "{app}"; Flags: ignoreversion
Source: "@FICTURE2_INNO_THUMBNAIL_PROVIDER_PATH@"; DestDir: "{app}"; Flags: ignoreversion; Check: ShouldRegisterThumbnailProvider

[Icons]
Name: "{group}\@FICTURE2_INNO_APP_NAME@"; Filename: "{app}\@FICTURE2_INNO_EXE_NAME@"; Tasks: startmenu
Name: "{group}\Uninstall @FICTURE2_INNO_APP_NAME@"; Filename: "{uninstallexe}"; Tasks: startmenu

[Registry]
Root: HKCU; Subkey: "Software\Classes\FICture2.Image"; ValueType: string; ValueName: ""; ValueData: "FICture2 Image"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\FICture2.Image\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\@FICTURE2_INNO_EXE_NAME@,0"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\FICture2.Image\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\@FICTURE2_INNO_EXE_NAME@"" ""%1"""; Tasks: fileassoc; Flags: uninsdeletekey

Root: HKCU; Subkey: "Software\Classes\.png"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.jpg"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.jpeg"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.bmp"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.tif"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.tiff"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.gif"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.dds"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.tga"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\.ico"; ValueType: string; ValueName: ""; ValueData: "FICture2.Image"; Tasks: fileassoc; Flags: uninsdeletevalue

Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\@FICTURE2_INNO_EXE_NAME@"" ""%1"""; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\@FICTURE2_INNO_EXE_NAME@,0"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "@FICTURE2_INNO_APP_NAME@"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.png"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.jpg"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.jpeg"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.bmp"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.tif"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.tiff"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.gif"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.dds"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.tga"; Tasks: fileassoc; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\Applications\@FICTURE2_INNO_EXE_NAME@\SupportedTypes\.ico"; Tasks: fileassoc; Flags: uninsdeletekey

[Run]
Filename: "regsvr32.exe"; Parameters: "/s ""{app}\ThumbnailProvider.dll"""; Tasks: thumbprovider; Check: ShouldInstallThumbnailProvider

[UninstallRun]
Filename: "regsvr32.exe"; Parameters: "/s /u ""{app}\ThumbnailProvider.dll"""; Tasks: thumbprovider; Check: ShouldInstallThumbnailProvider

[UninstallDelete]
Type: filesandordirs; Name: "{app}"

[Code]
function ShouldInstallThumbnailProvider(): Boolean;
begin
  Result := @FICTURE2_INNO_INSTALL_THUMBNAIL_PROVIDER@;
end;
